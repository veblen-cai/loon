# ============================================================
# Host
#
# tvOS 不建议使用你原来那组 Apple CDN 强制 Host 映射。
#
# 特别是：
#
# updates.cdn-apple.com
#
# Apple TV 本身就是 Apple 系统设备，
# 没必要对系统更新 CDN 强制重写。
# ============================================================

[Host]



# ============================================================
# Rewrite
# ============================================================

[Rewrite]



# ============================================================
# Script
# ============================================================

[Script]



# ============================================================
# Remote Script
# ============================================================

[Remote Script]



# ============================================================
# Plugin
#
# tvOS 第一阶段全部关闭。
#
# 确认代理稳定后可以逐个打开。
# 推荐恢复顺序：
#
# 1 Block_HTTPDNS
# 2 BlockAdvertisers
# 3 Remove_ads
#
# Sub-Store / Script-Hub / BoxJs
# Apple TV 一般没有必要常驻。
# ============================================================

[Plugin]


https://kelee.one/Tool/Loon/Lpx/Block_HTTPDNS.lpx,pin=true,enabled=false


https://kelee.one/Tool/Loon/Lpx/BlockAdvertisers.lpx,pin=true,enabled=false


https://kelee.one/Tool/Loon/Lpx/Remove_ads_by_keli.lpx,pin=true,enabled=false


https://loon.103516.xyz/Plugin/Sub-Store.lpx,policy=故障转移,enabled=false


https://loon.103516.xyz/Plugin/Script-Hub.lpx,policy=故障转移,enabled=false


https://loon.103516.xyz/Plugin/BoxJs.lpx,policy=故障转移,enabled=false



# ============================================================
# MITM
#
# tvOS 稳定版先彻底不使用 MITM。
#
# 不要直接把 iPhone 的 ca-p12 粘贴过来。
# 如果以后 tvOS 确实需要 HTTPS Rewrite，
# 在 Apple TV 端单独安装并信任 CA。
# ============================================================

[MITM]

hostname =

skip-server-cert-verify = false